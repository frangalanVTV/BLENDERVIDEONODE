# Dependencies
node_modules/

# Next.js
.next/
out/
build/

# Env
.env*.local
.env

# Editor / OS
.DS_Store
.vscode/
.idea/

# Note: public/render.png, public/frente.png and public/videos ARE
# versioned in git — they're what the app actually serves, so there's a
# single copy of each, no root-level duplicates. The final video exports
# are ~180MB total, well under GitHub's 100MB per-file limit, so the repo
# stays self-contained and deployable as-is. If raw/unconverted footage
# ever lands here again, ignore it explicitly rather than relying on a
# blanket media exclusion.

# TypeScript incremental build cache
*.tsbuildinfo

# Auto-generated by Next.js on every `dev`/`build` run; its content differs
# between the two, which just creates staging noise. Next recreates it if
# missing, so it doesn't need to be tracked.
next-env.d.ts

# Personal reference material, not used by the app
/capturas/
/REFERENCIAS/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
